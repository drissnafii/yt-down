{
  "name": "yt-down",
  "license": "MIT",
  "module": "bin/yt-down.ts",
  "type": "module",
  "bin": {
    "yt-down": "./bin/yt-down.ts"
  },
  "scripts": {
    "start": "bun run bin/yt-down.ts",
    "dev": "bun run --watch bin/yt-down.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "benchmark": "bun run scripts/benchmark.ts",
    "extension:build": "bun run scripts/extension.ts build",
    "extension:install": "bun run scripts/extension.ts install",
    "extension:pack": "bun run scripts/extension.ts pack",
    "extension:typecheck": "tsc -p extension/tsconfig.json",
    "extension:smoke": "bun run scripts/extension-smoke.ts",
    "benchmark:gnome": "bun run scripts/benchmark-gnome.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@girs/clutter-51": "^5.6.0",
    "@girs/gjs": "^5.6.0",
    "@girs/gnome-shell": "^51.0.1",
    "@girs/st-51": "^5.6.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
